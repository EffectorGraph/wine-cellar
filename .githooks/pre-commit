#!/usr/bin/env python3
"""Validate staged data; Actions owns generated output freshness."""
import pathlib
import subprocess
import sys
import tempfile
root = pathlib.Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
data = subprocess.check_output(["git", "show", ":cellar.jsonl"])
with tempfile.NamedTemporaryFile(suffix=".jsonl") as staged:
    staged.write(data)
    staged.flush()
    result = subprocess.run([sys.executable, str(root / "skill/scripts/validate_cellar.py"), staged.name])
sys.exit(result.returncode)
